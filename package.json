{
  "name": "ops-agent",
  "version": "1.0.0",
  "description": "A Telegram operations agent with tool calling, model failover, an approval gate for risky actions and a self-healing watchdog.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "chat": "tsx src/cli.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.43.0",
    "openai": "^4.96.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  }
}
