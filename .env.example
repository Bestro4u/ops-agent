# Copy to .env and fill in what you need. Only one model key is required.

# Model providers (OpenAI-compatible endpoints). The agent starts on the first one
# that has a key, in this order, unless LLM_PROVIDER says otherwise.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=gemini

# Optional: override a provider's model chain, best first, comma separated.
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
# OPENROUTER_MODELS=deepseek/deepseek-chat,google/gemini-2.5-flash
# OPENAI_MODELS=gpt-4.1-mini,gpt-4.1

# Telegram mode only (npm start). Terminal mode (npm run chat) needs neither.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. The bot answers this person only, and sends approval cards here.
OWNER_CHAT_ID=

# Where state is saved (provider choice, approvals, demo CRM). Defaults to data/state.json.
# STATE_FILE=data/state.json

# Watchdog sweep interval in minutes (Telegram mode).
# WATCHDOG_MINUTES=15
